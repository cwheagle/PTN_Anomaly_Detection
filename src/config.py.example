# --- 알람 판정 정책 (선택): src/pipeline/alerting.py 의 AlertPolicy 기본값을 덮어쓴다 -------------------
# 설정하지 않으면 기본 정책(아래 주석의 default)이 적용된다. 모델과 짝으로 정해야 하므로 모델 승격 시 함께 검토할 것.
#
#   default (기본)            : threshold_scale=1.0, sigma_k=3.0, dampening_steps={1: 3, 2: 2, 3: 1}
#   precision (오탐 억제형)    : threshold_scale=3.0, sigma_k=2.0, dampening_steps={1: 6, 2: 4, 3: 3}
#
# precision 프리셋 (시뮬레이션 기준, 정상 변동을 포함해 학습한 모델 'noisy' 와 짝):
#   검증 전용 시드 3개 평균 이벤트 F1 0.617 -> 0.796, 오탐 0.100 -> 0.010 건/포트·일,
#   그 대가로 조기 탐지율 77% -> 65%, 리드타임 중앙값 205 -> 152분 (알람이 최소 연속 3스텝=45분 뒤에 나감).
#   현장이 오탐과 예지 중 무엇을 더 중시하는지에 따라 선택. 실데이터로 검증된 값이 아님.
#
# [모델별 정책 (P1-3)] 이 ALERT_POLICY 는 '모델 메타(alert_policy)에 정책이 없는 모델'의 기본 정책이다.
#   활성 모델 메타에 alert_policy 가 있으면 그 정책이 이 값보다 **우선**한다 (우선순위: 모델 메타 > ALERT_POLICY > 코드 기본값).
#   메타 정책은 학습 요청의 alert_policy(프리셋 default / precision, src/pipeline/alerting.py POLICY_PRESETS)로 지정하며
#   롤백하면 정책도 이전 모델의 것으로 함께 돌아간다. 정책 메타가 없는 모델(v1)은 이 값(없으면 코드 기본값)으로 동작한다.
# ALERT_POLICY = {
#     "threshold_scale": 3.0,
#     "sigma_k": 2.0,
#     "dampening_steps": {1: 6, 2: 4, 3: 3},   # MINOR / MAJOR / CRITICAL 이 알람이 되기 위한 연속 스텝 수
# }

# ---------------------------------------------------------------------------
# 재학습 정책 (선택, P1-1). 모든 키는 코드 기본값(src/pipeline/retrain_policy.py)을 가지며, 여기서는 바꿀 것만 적는다.
# mode 는 환경변수 DRIFT_RETRAIN_MODE 가 우선한다 (docker-compose 의 api 서비스).
#   off       : 드리프트를 감지·알림만 하고 재학습하지 않음
#   candidate : (기본) 후보 모델로만 학습, 사람이 게이트 결과를 보고 승격
#   auto      : 승격 게이트 통과 시 자동 활성화 (후보 3회 이상에서 게이트 판정과 사람의 판단이 일치한 뒤에만 검토)
# 근거: docs/design/p1_1_retrain_pipeline.md (5장 기본값)
# RETRAIN_POLICY = {
#     "mode": "candidate",
#     "train_days": 28,                  # 학습 구간 [T-28d, T]. 알람 이력 보존(RETENTION_DAYS=30) 안쪽이어야 함
#     "val_port_fraction": 0.10,         # 검증용으로 남겨두는 포트 비율 (포트 단위 홀드아웃)
#     "max_excluded_fraction": 0.20,     # 장애 의심 구간이 학습 데이터의 이 비율을 넘으면 학습 중단
#     "drift_persist_checks": 3,         # 광역 드리프트가 연속 며칠 지속돼야 재학습을 시작하는지
#     "cooldown_hours": 72,              # 재학습 트리거 후 다음 트리거까지 최소 간격
#     "drift_median_factor": 1.5,        # 포트별 평균 score 중앙값이 기준의 이 배수를 넘으면 광역 드리프트
#     "drift_port_fraction": 0.30,       # 기준 p90 을 넘는 포트가 이 비율을 넘으면 광역 드리프트 (정상 기대치 0.10)
#     "gate_min_port_days": 150,         # 게이트 홀드아웃 포트 x 일수가 이보다 작으면 G3 판정 불가(SKIP) -> 종합 WARN (auto 비승격)
#     "gate_max_incidents_per_port_day": 0.05,  # G3 절대 상한: 후보 알람이 이를 넘으면 **WARN**(FAIL 아님 — auto 만 차단, 수동 승격은 가능).
#                                               # FAIL 은 활성 모델 대비 gate_max_alarm_ratio(1.5배, 하한 gate_alarm_floor 0.01) 초과일 때
# }
